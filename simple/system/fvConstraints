FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvConstraints;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

limitT
{
    type        limitTemperature;
    select      all;
    min         100;
    max         5000;
}

limitP
{
    type        limitPressure;
    min         10000;
    max         1000000;
}

