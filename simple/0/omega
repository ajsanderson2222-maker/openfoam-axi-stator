FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 8805;

boundaryField
{
    NONREFLECTIVE_INFLOW
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    0.000254;
        value           uniform 8805;
    }

    NONREFLECTIVE_OUTFLOW
    {
        type            inletOutlet;
        inletValue      uniform 8805;
        value           uniform 8805;
    }

    NO_SLIP_WALL_WITH_SPECIFIED_V   { type omegaWallFunction; value uniform 8805; }
    NO_SLIP_WALL_WITH_SPECIFIED_V_2 { type omegaWallFunction; value uniform 8805; }
    NO_SLIP_IN_RELATIVE_FRAME       { type omegaWallFunction; value uniform 8805; }
    PERIODIC_FACE                   { type cyclic; }
    PERIODIC_SHADOW_FACE            { type cyclic; }
}

