FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alphat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    NONREFLECTIVE_INFLOW        { type zeroGradient; }
    NONREFLECTIVE_OUTFLOW       { type zeroGradient; }
    NO_SLIP_WALL_WITH_SPECIFIED_V   { type compressible::alphatWallFunction; nut nut; value uniform 0; }
    NO_SLIP_WALL_WITH_SPECIFIED_V_2 { type compressible::alphatWallFunction; nut nut; value uniform 0; }
    NO_SLIP_IN_RELATIVE_FRAME       { type compressible::alphatWallFunction; nut nut; value uniform 0; }
    PERIODIC_FACE                   { type cyclic; }
    PERIODIC_SHADOW_FACE            { type cyclic; }
}

