FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Tt_in = 1000 R = 555.56 K

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 555.56;

boundaryField
{
    NONREFLECTIVE_INFLOW
    {
        type            totalTemperature;
        gamma           1.4;
        T0              uniform 555.56;
        value           uniform 555.56;
    }

    NONREFLECTIVE_OUTFLOW       { type zeroGradient; }
    NO_SLIP_WALL_WITH_SPECIFIED_V   { type zeroGradient; }
    NO_SLIP_WALL_WITH_SPECIFIED_V_2 { type zeroGradient; }
    NO_SLIP_IN_RELATIVE_FRAME       { type zeroGradient; }
    PERIODIC_FACE                   { type cyclic; }
    PERIODIC_SHADOW_FACE            { type cyclic; }
}

