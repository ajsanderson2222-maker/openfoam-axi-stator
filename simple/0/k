FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1.5;

boundaryField
{
    NONREFLECTIVE_INFLOW
    {
        type            turbulentIntensityKineticEnergyInlet;
        intensity       0.01;
        value           uniform 1.5;
    }

    NONREFLECTIVE_OUTFLOW
    {
        type            inletOutlet;
        inletValue      uniform 1.5;
        value           uniform 1.5;
    }

    NO_SLIP_WALL_WITH_SPECIFIED_V   { type kqRWallFunction; value uniform 1.5; }
    NO_SLIP_WALL_WITH_SPECIFIED_V_2 { type kqRWallFunction; value uniform 1.5; }
    NO_SLIP_IN_RELATIVE_FRAME       { type kqRWallFunction; value uniform 1.5; }
    PERIODIC_FACE                   { type cyclic; }
    PERIODIC_SHADOW_FACE            { type cyclic; }
}

