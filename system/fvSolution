FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    // Density, momentum, energy — updated explicitly by Kurganov-Tadmor flux
    "(rho|rhoU|rhoE).*"
    {
        solver          diagonal;
    }

    // Velocity and internal energy smoothed implicitly for stability
    "U.*"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        nSweeps         2;
        tolerance       1e-10;
        relTol          0;
    }

    "e.*"
    {
        $U;
    }

    "(k|omega).*"
    {
        $U;
    }
}

PIMPLE
{
    nOuterCorrectors    1;
}

