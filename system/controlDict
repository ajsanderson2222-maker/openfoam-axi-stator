FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     shockFluid;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         5e-4;

deltaT          1e-9;           // starting dt — ramps up under maxCo 0.5
adjustTimeStep  yes;
maxCo           0.5;

writeControl    adjustableRunTime;
writeInterval   1e-4;
purgeWrite      5;

writeFormat     binary;
writePrecision  8;

runTimeModifiable   true;

functions
{
    // ------------------------------------------------------------------
    // Total pressure field  p_total = p + 0.5*rho*|U|^2
    // ------------------------------------------------------------------
    totalPressure
    {
        type            pressure;
        libs            ("libfieldFunctionObjects.so");
        field           p;
        U               U;
        rho             rho;
        calcTotal       yes;
        calcCoeff       no;
        pRef            0;
        result          p_total;
        writeControl    adjustableRunTime;
        writeInterval   1e-4;
    }

    // ------------------------------------------------------------------
    // Area-weighted average p_total at inlet patch
    // ------------------------------------------------------------------
    pt_inlet
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        fields          (p_total);
        operation       areaAverage;
        patch           NONREFLECTIVE_INFLOW;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        log             true;
    }

    pt_outlet
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        fields          (p_total);
        operation       areaAverage;
        patch           NONREFLECTIVE_OUTFLOW;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        log             true;
    }
}

