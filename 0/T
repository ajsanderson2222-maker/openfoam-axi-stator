FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Tt_in = 1000 R = 555.56 K
TIn     555.56;

dimensions      [0 0 0 1 0 0 0];

internalField   uniform $TIn;

boundaryField
{
    NONREFLECTIVE_INFLOW
    {
        type            fixedValue;
        value           uniform $TIn;
    }

    NONREFLECTIVE_OUTFLOW
    {
        type            zeroGradient;
    }

    NO_SLIP_WALL_WITH_SPECIFIED_V
    {
        type            zeroGradient;
    }

    NO_SLIP_WALL_WITH_SPECIFIED_V_2
    {
        type            zeroGradient;
    }

    NO_SLIP_IN_RELATIVE_FRAME
    {
        type            zeroGradient;
    }

    PERIODIC_FACE
    {
        type            cyclic;
    }

    PERIODIC_SHADOW_FACE
    {
        type            cyclic;
    }
}

