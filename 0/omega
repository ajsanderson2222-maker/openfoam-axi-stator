FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Lt = 0.01 in = 0.000254 m
omegaInitial    1;

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform $omegaInitial;

boundaryField
{
    NONREFLECTIVE_INFLOW
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    0.000254;
        value           uniform $omegaInitial;
    }

    NONREFLECTIVE_OUTFLOW
    {
        type            inletOutlet;
        inletValue      uniform $omegaInitial;
        value           uniform $omegaInitial;
    }

    NO_SLIP_WALL_WITH_SPECIFIED_V
    {
        type            omegaWallFunction;
        value           uniform $omegaInitial;
    }

    NO_SLIP_WALL_WITH_SPECIFIED_V_2
    {
        type            omegaWallFunction;
        value           uniform $omegaInitial;
    }

    NO_SLIP_IN_RELATIVE_FRAME
    {
        type            omegaWallFunction;
        value           uniform $omegaInitial;
    }

    PERIODIC_FACE
    {
        type            cyclic;
    }

    PERIODIC_SHADOW_FACE
    {
        type            cyclic;
    }
}

