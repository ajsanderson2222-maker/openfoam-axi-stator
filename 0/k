FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    NONREFLECTIVE_INFLOW
    {
        type            turbulentIntensityKineticEnergyInlet;
        intensity       0.01;
        value           uniform 0;
    }

    NONREFLECTIVE_OUTFLOW
    {
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }

    NO_SLIP_WALL_WITH_SPECIFIED_V
    {
        type            kqRWallFunction;
        value           uniform 0;
    }

    NO_SLIP_WALL_WITH_SPECIFIED_V_2
    {
        type            kqRWallFunction;
        value           uniform 0;
    }

    NO_SLIP_IN_RELATIVE_FRAME
    {
        type            kqRWallFunction;
        value           uniform 0;
    }

    PERIODIC_FACE
    {
        type            cyclic;
    }

    PERIODIC_SHADOW_FACE
    {
        type            cyclic;
    }
}

